// Lappidoth & Co. — data model (PostgreSQL)
// DATABASE_URL: pooled connection used by the app.
// DATABASE_URL_UNPOOLED: direct connection used for migrations.
// (These are the names Neon's Vercel integration sets automatically.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Catalogue ────────────────────────────────────────────────────────────

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  // CANDLE = a single candle; SET = a bundle where the customer picks `setSize` candles
  type         String      @default("CANDLE")
  setSize      Int?
  tagline      String
  description  String
  // Optional fragrance notes — shown only when filled in
  topNotes     String?
  heartNotes   String?
  baseNotes    String?
  priceCents   Int         // in pence
  currency     String      @default("GBP")
  burnTime     String      @default("30+ hours")
  netWeight    String      @default("5 oz / 141 g")
  wax          String      @default("Natural soy wax")
  image        String
  // null = not tracked; a number = units available (0 shows "Sold out")
  stock        Int?
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  collectionId String
  collection   Collection  @relation(fields: [collectionId], references: [id])
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ─── CRM ──────────────────────────────────────────────────────────────────

// One row per person, keyed by email. Forms and orders all upsert here.
model Customer {
  id             String        @id @default(cuid())
  email          String        @unique
  firstName      String?
  lastName       String?
  phone          String?
  // LEAD | SUBSCRIBER | CUSTOMER | VIP | ARCHIVED (see src/lib/crm.ts)
  status         String        @default("LEAD")
  // Where we first met them: newsletter | contact | waitlist | checkout | admin | import
  source         String        @default("website")
  marketingOptIn Boolean       @default(false)
  tags           Tag[]
  interactions   Interaction[]
  orders         Order[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  customers Customer[]
}

// The customer timeline: form submissions, notes, orders.
model Interaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // NEWSLETTER_SIGNUP | CONTACT_FORM | WAITLIST | NOTE | ORDER_PLACED
  type       String
  subject    String?
  body       String?
  metadata   String? // JSON
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// ─── Orders ───────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  number          String      @unique // e.g. LC-1001
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  // PENDING (awaiting payment) | PAID | DISPATCHED | CANCELLED | REFUNDED
  status          String      @default("PENDING")
  email           String?
  subtotalCents   Int
  shippingCents   Int         @default(0)
  discountCents   Int         @default(0)
  totalCents      Int
  currency        String      @default("GBP")
  shippingMethod  String?
  shippingName    String?
  shippingAddress String?     // JSON
  phone           String?
  giftMessage     String?
  // Payment provider references (Stripe today; the model is provider-neutral)
  paymentProvider String      @default("stripe")
  checkoutRef     String?     @unique // Stripe Checkout Session id
  paymentRef      String?     // Stripe PaymentIntent id
  paidAt          DateTime?
  dispatchedAt    DateTime?
  trackingNumber  String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String   // snapshot at time of purchase
  options        String?  // e.g. "So Loved, Connect" for a Duo
  quantity       Int
  unitPriceCents Int
}
