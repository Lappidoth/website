# Database — PostgreSQL. On Vercel, the Neon integration sets both of these.
# Locally, point both at your own Postgres.
DATABASE_URL="postgresql://postgres@localhost:5432/lappidoth"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5432/lappidoth"

# Admin / CRM login (HTTP Basic auth on /admin). Admin is disabled if unset.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Public URL (no trailing slash). On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe — use test keys (sk_test_…) until you're ready to take real payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
