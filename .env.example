# Database — SQLite file for local dev. Use a postgres:// URL in production
# (and switch the provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Admin / CRM login (HTTP Basic auth on /admin). Admin is disabled if unset.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Public URL, used for metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
